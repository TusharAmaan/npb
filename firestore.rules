rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // STRICT ADMIN ACCESS: Only tushar.aman05@gmail.com is granted write / mutation access
    function isTusharAdmin() {
      return request.auth != null && 
        request.auth.token.email.lower() == "tushar.aman05@gmail.com";
    }

    // Settings: Public read (for branding & theme), only tushar.aman05@gmail.com can write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Batches: Public read (for schedule display), only tushar.aman05@gmail.com can write
    match /batches/{batchId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Schools: Public read (for directory), only tushar.aman05@gmail.com can write
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Students: Public read (for leaderboard & parent report card), only tushar.aman05@gmail.com can write
    match /students/{studentId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Student Syllabi: Read for student progress, only tushar.aman05@gmail.com can write
    match /studentSyllabi/{studentId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Class Sessions & Attendance: Read for student history, only tushar.aman05@gmail.com can write
    match /classSessions/{sessionId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Homeworks: Read for student homework tracker, only tushar.aman05@gmail.com can write
    match /homeworks/{homeworkId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Exams: Read for leaderboard scoring, only tushar.aman05@gmail.com can write
    match /exams/{examId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Lecture Sheets: Only tushar.aman05@gmail.com can write
    match /lectureSheets/{sheetId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Bonus Logs: Only tushar.aman05@gmail.com can write
    match /bonusLogs/{logId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Class Goals & Routine Targets: Only tushar.aman05@gmail.com can write
    match /classGoals/{goalId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Online Interactive Exams: Public read for students taking exam, only tushar.aman05@gmail.com can create/edit
    match /onlineExams/{examId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Exam Submissions: Public read and write (students submit exam answers without login, tutor can manage/delete)
    match /examSubmissions/{submissionId} {
      allow read, write: if true;
    }

    // Catch-all fallback: Read allowed, all writes strictly locked to tushar.aman05@gmail.com
    match /{document=**} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }
  }
}
