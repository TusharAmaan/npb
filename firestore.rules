rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Only tushar.aman05@gmail.com is granted admin access
    function isTusharAdmin() {
      return request.auth != null && 
        request.auth.token.email.lower() == "tushar.aman05@gmail.com";
    }

    // Settings: Public can read platform name & theme, only tushar.aman05@gmail.com can write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isTusharAdmin();
    }

    // Batches: Only tushar.aman05@gmail.com has access
    match /batches/{batchId} {
      allow read, write: if isTusharAdmin();
    }

    // Schools: Only tushar.aman05@gmail.com has access
    match /schools/{schoolId} {
      allow read, write: if isTusharAdmin();
    }

    // Students: Private student records, only tushar.aman05@gmail.com can access
    match /students/{studentId} {
      allow read, write: if isTusharAdmin();
    }

    // Student Syllabi: Only tushar.aman05@gmail.com can access
    match /studentSyllabi/{studentId} {
      allow read, write: if isTusharAdmin();
    }

    // Class Sessions & Attendance: Only tushar.aman05@gmail.com can access
    match /classSessions/{sessionId} {
      allow read, write: if isTusharAdmin();
    }

    // Homeworks: Only tushar.aman05@gmail.com can access
    match /homeworks/{homeworkId} {
      allow read, write: if isTusharAdmin();
    }

    // Exams: Only tushar.aman05@gmail.com can access
    match /exams/{examId} {
      allow read, write: if isTusharAdmin();
    }

    // Lecture Sheets: Only tushar.aman05@gmail.com can access
    match /lectureSheets/{sheetId} {
      allow read, write: if isTusharAdmin();
    }

    // Bonus Logs: Only tushar.aman05@gmail.com can access
    match /bonusLogs/{logId} {
      allow read, write: if isTusharAdmin();
    }

    // Catch-all: Deny all reads & writes unless authenticated as tushar.aman05@gmail.com
    match /{document=**} {
      allow read, write: if isTusharAdmin();
    }
  }
}
